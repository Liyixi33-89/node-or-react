    "koa-bodyparser": "^4.4.1",
    "koa-router": "^12.0.1",
    "moment": "^2.29.4",
    "mongoose": "^8.0.3",
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.0.2",
    "pm2": "^5.3.0"
