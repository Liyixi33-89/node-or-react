# 后端环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# 服务端口
PORT=3000

# 运行环境 (development | production)
NODE_ENV=development

# MongoDB 连接字符串
# 本地MongoDB: mongodb://localhost:27017/attendance
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/attendance
MONGODB_URI=mongodb://localhost:27017/attendance

# JWT密钥（如果使用JWT认证）
# JWT_SECRET=your-secret-key-here
# JWT_EXPIRES_IN=7d

# 日志级别
# LOG_LEVEL=info

# CORS配置
# CORS_ORIGIN=http://localhost:5173
